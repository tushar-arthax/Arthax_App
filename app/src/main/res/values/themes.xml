<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the real theming; this exists so the window has correct colours
      during the cold-start frame before the first composition, which otherwise
      flashes white on a dark-mode device.
    -->
    <style name="Theme.Arthax" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
      For DialRequestActivity: it only exists to hand a notification tap to the dialler,
      so it must never be seen - no window colour, no animation, nothing in the transition.
    -->
    <style name="Theme.Arthax.Invisible">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsFloating">false</item>
    </style>
</resources>
