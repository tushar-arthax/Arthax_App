<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      Android 13+ themed icons. The system throws away colour here and keeps only the
      alpha, so this is a flat white silhouette of the mark rather than the mark itself -
      pointing this at the colour foreground gives a muddy blob on a themed home screen.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
